# Base de donnees PostgreSQL (locale ou hebergee — voir le README, section
# "Base de donnees", pour creer une base gratuite chez Neon en quelques
# minutes si tu deploies le site sur Vercel).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Optionnel : IA (Claude / Anthropic) ---
# Si absent, le site fonctionne quand meme avec un algorithme de matching
# par mots-cles/competences et une adaptation de CV par templates.
# Si present, le matching est affine et l'adaptation de CV est generee par Claude
# (toujours sans inventer de competences absentes du CV original).
ANTHROPIC_API_KEY=

# --- Optionnel : recuperation automatique d'offres via l'API France Travail ---
# Cree des identifiants sur https://francetravail.io (application "Offres d'emploi v2")
# Sans ces cles, seul l'ajout manuel d'offres est disponible.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Optionnel : source additionnelle d'offres via l'API Adzuna ---
# Cle gratuite sur https://developer.adzuna.com. Les deux sources peuvent
# etre activees en meme temps (les doublons entre sources sont detectes
# automatiquement via URL / identifiant externe / empreinte de contenu).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Optionnel : source additionnelle d'offres via l'API "La bonne alternance" ---
# API gouvernementale gratuite (usage non commercial), specifique a
# l'alternance/apprentissage. Pas de cle a creer : mettre a "true" pour
# l'activer. ATTENTION : integration recente, pas encore totalement
# fiabilisee en conditions reelles (voir README).
LBA_ENABLED=

# --- Optionnel : synchronisation Gmail (detection automatique des reponses) ---
# Voir le README ("Synchronisation Gmail") pour la procedure Google Cloud complete.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit correspondre EXACTEMENT a l'URI de redirection autorisee dans Google Cloud.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# --- Optionnel : protege /api/gmail/sync et /api/offers/fetch quand le site
# est deploye publiquement ---
# Si defini, l'appel a ces routes doit inclure l'en-tete
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron l'ajoute automatiquement
# si CRON_SECRET est defini dans les variables d'environnement du projet).
CRON_SECRET=

# --- Optionnel : conservation du fichier CV original (Vercel Blob) ---
# Ajoute le store "Blob" dans les parametres du projet Vercel (Storage ->
# Create Database -> Blob) : la variable est alors ajoutee automatiquement.
# Sans elle, le CV original n'est pas conserve tel quel : la page "Mes CV"
# reconstruit un PDF propre a partir du texte deja extrait a l'import.
BLOB_READ_WRITE_TOKEN=
