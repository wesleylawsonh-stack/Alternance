# Base de données locale (SQLite)
DATABASE_URL="file:../data/dev.db"

# --- Optionnel : IA (Claude / Anthropic) ---
# Si absent, le site fonctionne quand meme avec un algorithme de matching
# par mots-cles/competences et une adaptation de CV par templates.
# Si present, le matching est affine et l'adaptation de CV est generee par Claude
# (toujours sans inventer de competences absentes du CV original).
ANTHROPIC_API_KEY=

# --- Optionnel : recuperation automatique d'offres via l'API France Travail ---
# Cree des identifiants sur https://francetravail.io (application "Offres d'emploi v2")
# Sans ces cles, seul l'ajout manuel d'offres est disponible.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
