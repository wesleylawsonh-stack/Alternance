# Configuration Netlify : mise en cache et sécurité

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Les pages sont toujours revérifiées, pour que les changements de carte apparaissent tout de suite
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Polices : ne changent jamais
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photos : gardées 7 jours dans le navigateur
/images/*
  Cache-Control: public, max-age=604800
